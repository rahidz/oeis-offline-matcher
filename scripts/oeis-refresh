#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"
mkdir -p data/processed
exec 9>data/processed/refresh.lock
if ! flock -n 9; then
  echo "An OEIS refresh is already running." >&2
  exit 1
fi
exec > >(tee data/processed/refresh.log) 2>&1
echo "[refresh] started $(date -Is)"
scripts/oeis-start --no-status -- python -u -m oeis_matcher.refresh "$@"
echo "[refresh] completed $(date -Is)"
